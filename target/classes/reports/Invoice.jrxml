<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HoaDonExtraLatte" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="970ba4bc-cacc-44c7-bf42-f25494c9ee9c">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle_Connection"/>
	
	<parameter name="p_MaDonHang" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	
	<queryString>
		<![CDATA[SELECT 
    dh.MaDonHang, 
    TO_CHAR(dh.NgayDat, 'DD/MM/YYYY HH24:MI') AS NgayDat,
    dh.TongTien, 
    dh.SoTienGiam, 
    dh.TongTienThue, 
    dh.ThanhTien AS TongCong,
    NVL(kh.HoTen, N'Khách vãng lai') AS TenKhachHang,
    nd.HoTen AS TenNhanVien,
    sp.TenSanPham, 
    bt.TenSize, 
    ctdh.SoLuong, 
    ctdh.ThanhTien AS TienMon,
    (SELECT LISTAGG(tp.TenTopping, ', ') WITHIN GROUP (ORDER BY tp.TenTopping)
     FROM CHI_TIET_TOPPING ctt
     JOIN TOPPING tp ON ctt.MaTopping = tp.MaTopping
     WHERE ctt.MaCTHD = ctdh.MaChiTietDon) AS ToppingDiKem
FROM DON_HANG dh
LEFT JOIN KHACH_HANG kh ON dh.MaKhachHang = kh.MaKhachHang
JOIN TAI_KHOAN tk ON dh.MaTaiKhoan = tk.MaTaiKhoan
JOIN NGUOI_DUNG nd ON tk.MaNguoiDung = nd.MaNguoiDung
JOIN CHI_TIET_DON_HANG ctdh ON dh.MaDonHang = ctdh.MaDonHang
JOIN BIEN_THE bt ON ctdh.MaBienThe = bt.MaBienThe
JOIN SAN_PHAM sp ON bt.MaSanPham = sp.MaSanPham
WHERE dh.MaDonHang = $P{p_MaDonHang}]]>
	</queryString>
	
	<field name="MADONHANG" class="java.math.BigDecimal"/>
	<field name="NGAYDAT" class="java.lang.String"/>
	<field name="TONGTIEN" class="java.math.BigDecimal"/>
	<field name="SOTIENGIAM" class="java.math.BigDecimal"/>
	<field name="TONGTIENTHUE" class="java.math.BigDecimal"/>
	<field name="TONGCONG" class="java.math.BigDecimal"/>
	<field name="TENKHACHHANG" class="java.lang.String"/>
	<field name="TENNHANVIEN" class="java.lang.String"/>
	<field name="TENSANPHAM" class="java.lang.String"/>
	<field name="TENSIZE" class="java.lang.String"/>
	<field name="SOLUONG" class="java.math.BigDecimal"/>
	<field name="TIENMON" class="java.math.BigDecimal"/>
	<field name="TOPPINGDIKEM" class="java.lang.String"/>

