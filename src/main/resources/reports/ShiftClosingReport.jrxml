<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BienBanGiaoCa" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30" uuid="c2b5e7f1-8a9d-4e3c-b1f4-9d8e7a6c5b4d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle_Connection"/>
	
	<parameter name="p_MaPhienCa" class="java.lang.Integer"/>
	
	<queryString>
		<![CDATA[SELECT 
    pcl.MaPhienCa,
    TO_CHAR(pcl.ThoiGianMo, 'DD/MM/YYYY HH24:MI') AS ThoiGianMo,
    TO_CHAR(pcl.ThoiGianDong, 'DD/MM/YYYY HH24:MI') AS ThoiGianDong,
    nd_mo.HoTen AS NguoiGiao,
    NVL(nd_nhan.HoTen, N'Chưa xác định') AS NguoiNhan,
    NVL(pcl.GhiChu, N'Không có ghi chú') AS GhiChu,
    
    -- Số liệu Đối soát dòng tiền
    NVL(ds.SoTienDauCa, 0) AS TienDauCa,
    NVL(ds.SoTienHeThong, 0) AS TienHeThong,
    NVL(ds.SoTienThucTe, 0) AS TienThucTe,
    NVL(ds.TienChechLech, 0) AS TienChenhLech,
    
    -- Thống kê hóa đơn
    (SELECT COUNT(*) FROM DON_HANG WHERE MaPhienCa = pcl.MaPhienCa) AS TongSoDon,
    (SELECT COUNT(*) FROM DON_HANG WHERE MaPhienCa = pcl.MaPhienCa AND TrangThaiThanhToan = N'Đã thanh toán') AS DonDaThanhToan,
    (SELECT COUNT(*) FROM DON_HANG WHERE MaPhienCa = pcl.MaPhienCa AND TrangThaiThanhToan = N'Chưa thanh toán') AS DonChuaThanhToan,
    
    -- Doanh thu trong ca (Tổng tiền các đơn Đã thanh toán)
    NVL((SELECT SUM(ThanhTien) FROM DON_HANG WHERE MaPhienCa = pcl.MaPhienCa AND TrangThaiThanhToan = N'Đã thanh toán'), 0) AS DoanhThuCa
FROM PHIEN_CA_LAM pcl
JOIN TAI_KHOAN tk_mo ON pcl.MaTaiKhoanMo = tk_mo.MaTaiKhoan
JOIN NGUOI_DUNG nd_mo ON tk_mo.MaNguoiDung = nd_mo.MaNguoiDung
LEFT JOIN TAI_KHOAN tk_nhan ON pcl.MaTaiKhoanNhan = tk_nhan.MaTaiKhoan
LEFT JOIN NGUOI_DUNG nd_nhan ON tk_nhan.MaNguoiDung = nd_nhan.MaNguoiDung
LEFT JOIN DOI_SOAT_DONG_TIEN ds ON pcl.MaPhienCa = ds.MaPhienCa AND ds.NguonTien = N'Tiền mặt'
WHERE pcl.MaPhienCa = $P{p_MaPhienCa}]]>
	</queryString>
	
